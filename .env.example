PORT=4000
NODE_ENV=development
APP_DATABASE_URL="postgresql://saffron_admin:saffron_secret_password_2026@127.0.0.1:5432/saffron_threads_db?schema=public"
CORS_ORIGIN=http://localhost:3000
COOKIE_SECRET=replace_with_strong_secret_key_in_production
SESSION_MAX_AGE_DAYS=30

# Email (optional). Leave SMTP_HOST empty to record emails without sending them.
APP_URL=http://localhost:3000
ADMIN_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
# ssl = implicit TLS (port 465), tls/starttls = STARTTLS (port 587), none = plain (local test servers only)
SMTP_SECURITY=tls
SMTP_USER=
# Put the password in double quotes when it contains # $ or spaces, e.g. SMTP_PASS="ab#cd$ef"
SMTP_PASS=

# Sender. Most providers only accept the signed-in mailbox as the From address.
SMTP_FROM_NAME="Saffron Threads"
# Optional: a different From address on the same mailbox (alias). Defaults to SMTP_USER.
SMTP_FROM_EMAIL=
# Optional: a full From header that overrides the two above, e.g. "Saffron Threads <orders@example.com>"
EMAIL_FROM=

# Online payments with Cashfree (optional). Leave CASHFREE_APP_ID empty to offer Cash on Delivery only.
# Use the sandbox keys from the Cashfree dashboard while testing. Never commit the secret key.
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2026-01-01
# Public https address of this api (e.g. https://api.saffronvastra.com). Cashfree sends payment and refund webhooks to
# {PUBLIC_API_URL}/api/v1/payments/cashfree/webhook. Also register that url in the Cashfree dashboard (Developers > Webhooks).
PUBLIC_API_URL=

# ---------------------------------------------------------------------------------------------------------------
# Vercel deployment. On Vercel these are set in Project Settings > Environment Variables, not in a file.
# ---------------------------------------------------------------------------------------------------------------
# NODE_ENV=production (Vercel sets it for production deployments). COOKIE_SECRET above is then required.
# CORS_ORIGIN = the storefront's address, e.g. https://www.saffronvastra.com. APP_URL = the same address (used in emails).
# APP_DATABASE_URL = the connection string of the hosted Postgres (on Prisma Postgres the integration adds it with this name).

# How many proxies sit in front of the API. The storefront (a Vercel project) forwards /api to this project, so the
# request has crossed Vercel twice. Start with 2 and check the address shown in the audit log.
TRUST_PROXY=loopback

# Uploaded images. Create a Blob store in the Vercel dashboard (Storage > Blob) and connect it to this project: Vercel then
# adds this variable itself. Without it uploads are written to the local disk, which does not persist on Vercel.
BLOB_READ_WRITE_TOKEN=

# Protects /api/v1/internal/cron/*. Any random string of 16+ characters. Vercel sends it as "Authorization: Bearer ..."
# on every scheduled call, so the same variable must exist on the Vercel project.
CRON_SECRET=

# ---------------------------------------------------------------------------------------------------------------
# Vercel production: variables as last checked on 30 Oct 2026 (names only; values live on Vercel).
# ---------------------------------------------------------------------------------------------------------------
# Set and used by this code:   NODE_ENV, PORT, COOKIE_SECRET, CORS_ORIGIN, SESSION_MAX_AGE_DAYS, SMTP_HOST, SMTP_PORT,
#                              SMTP_SECURE, SMTP_SECURITY, SMTP_USER, SMTP_PASS, SMTP_FROM_NAME,
#                              CASHFREE_APP_ID, CASHFREE_SECRET_KEY, BLOB_READ_WRITE_TOKEN, APP_DATABASE_URL (added by the Prisma Postgres integration)
# Still to add on Vercel:      CRON_SECRET, TRUST_PROXY, APP_URL, PUBLIC_API_URL, CASHFREE_ENV (production when live)
# Added by Vercel integrations and NOT read by this code (the app reads APP_DATABASE_URL and BLOB_READ_WRITE_TOKEN):
#                              APP_POSTGRES_URL, APP_PRISMA_DATABASE_URL                    (Prisma Postgres; same address as APP_DATABASE_URL)
#                              BLOB_STORE_ID, BLOB_WEBHOOK_PUBLIC_KEY                        (Blob store)
# Set but not used by any code, safe to delete from Vercel and from .env: GEMINI_API_KEY
